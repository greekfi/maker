# --- chain ---
CHAIN=ethereum                 # ethereum | base | arbitrum | unichain
# CHAIN_ID=1                   # only needed if CHAIN is not in the built-in table

# --- signing ---
MAKER_ADDRESS=0x...            # address Bebop settles against
PRIVATE_KEY=0x...              # signs the EIP-712 quotes; production-critical
# PRIVATE_KEY must derive to MAKER_ADDRESS, or every quote you sign is
# unsettleable. `mm.py quote` checks this and fails loudly.

# --- options service (where option RFQs actually arrive) ---
BEBOP_OPTIONS_TOKEN=xxx        # partner token, sent as `Authorization: Bearer`

# --- PMM service (generic Bebop RFQ; optional) ---
# Its router does not carry option tokens, so option RFQs never arrive here.
# Set these only if you also want to stream protobuf levels to the PMM book.
BEBOP_MARKETMAKER=xxx          # `marketmaker` WS header
BEBOP_AUTHORIZATION=xxx        # `authorization` WS header

# --- instrument discovery ---
# Comma-separated, tried in order. Defaults to the Bebop options API for
# CHAIN, then options.greek.finance for the matching chain id.
# INSTRUMENT_URLS=https://api.bebop.xyz/options/ethereum/v1/instruments,https://options.greek.finance/42161/options.json

# --- pricing ---
DEFAULT_IV=0.8                 # ATM implied vol anchor
RISK_FREE_RATE=0.05
BID_SPREAD=0.02                # 2% below mid
ASK_SPREAD=0.02                # 2% above mid
IV_SKEW=-0.3                   # log-moneyness coefficient
IV_CURVATURE=3.0               # log-moneyness^2 coefficient
IV_TERM_REF_DAYS=30            # tenor at which the smile amplitude is measured
IV_PUT_OFFSET=0.0              # additive IV shift applied to puts only

# --- streaming ---
LEVEL_SIZE=1000                # size shown on each side, in base units (PMM only)
PRICING_INTERVAL=10            # seconds between pricing pushes (PMM only)
SPOT_POLL_INTERVAL=30
QUOTE_TTL=60                   # seconds a signed PMM quote stays valid
